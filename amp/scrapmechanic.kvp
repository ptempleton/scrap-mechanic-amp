Meta.DisplayName=Scrap Mechanic Survival (Interactive Steam)
Meta.Description=Windows user-session host via a local agent. Running means process detected; multiplayer readiness is unverified.
Meta.OS=Windows
Meta.Arch=x86_64
Meta.Author=Scrap Mechanic Host Project
Meta.URL=https://store.steampowered.com/app/387990/
Meta.DisplayImageSource=steam:387990
Meta.ConfigManifest=scrapmechanicconfig.json
Meta.MetaConfigManifest=scrapmechanicmetaconfig.json
Meta.ConfigRoot=scrapmechanic.kvp
Meta.MinAMPVersion=2.5.0.8
Meta.DockerRequired=False
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=1
Meta.AppConfigId=896b0b46-748a-45db-aab8-01ac80549c33
App.DisplayName=Scrap Mechanic process (readiness unverified)
App.RootDir=./scrapmechanic/
App.BaseDirectory=./scrapmechanic/
App.ExecutableWin=ScrapMechanic.Host.exe
App.WorkingDir=.
App.CommandLineArgs=bridge --config client.json
App.AppSettings={}
App.ExitMethod=String
App.ExitString=stop
App.ExitTimeout=900
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.Ports=@IncludeJson[scrapmechanicports.json]
App.UpdateSources=@IncludeJson[scrapmechanicupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.SupportsLiveSettingsChanges=False
App.RapidStartup=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
App.MonitorChildProcessName=
Console.AppReadyRegex=^SM_PROCESS_RUNNING multiplayer_readiness=unverified$
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
